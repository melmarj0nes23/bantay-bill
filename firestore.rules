rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Is the user signed in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Is the user the owner of the document?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Is the user an admin via verified email?
    function isAdmin() {
      return isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == 'balutp6@gmail.com';
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /bills/{billId} {
      // Allow read if user is signed in and owns the document (of existing data).
      // Allow write (create, update, delete) if user is signed in and owns the document (incoming/existing).
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) || 
        (resource != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
        (resource != null && request.resource == null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }

    match /expenses/{expenseId} {
      // Identical rules to bills: users can only read/write their own expenses
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) || 
        (resource != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
        (resource != null && request.resource == null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }
  }
}
