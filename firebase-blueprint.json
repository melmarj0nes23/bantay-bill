{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing settings, contact info, and role.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Full name of the user"
        },
        "email": {
          "type": "string",
          "description": "Email address of the user"
        },
        "currency": {
          "type": "string",
          "description": "Preferred billing currency",
          "enum": ["PHP", "USD", "EUR", "GBP"]
        },
        "billingCycleStart": {
          "type": "string",
          "description": "Day of month the billing cycle starts"
        },
        "twoFactorAuth": {
          "type": "boolean",
          "description": "2FA active status"
        },
        "avatarUrl": {
          "type": "string",
          "description": "User headshot URL"
        },
        "notifyDue": {
          "type": "boolean",
          "description": "Notify of due dates"
        },
        "notifyWeekly": {
          "type": "boolean",
          "description": "Weekly digest status"
        },
        "notifyAI": {
          "type": "boolean",
          "description": "AI optimization/tips enabled status"
        },
        "role": {
          "type": "string",
          "description": "User access level, user or admin",
          "enum": ["user", "admin"]
        }
      },
      "required": ["fullName", "email", "currency", "billingCycleStart", "twoFactorAuth", "avatarUrl", "notifyDue", "notifyWeekly", "notifyAI"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Representing a bill or recurring utility obligation.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name or provider of the utility / bill"
        },
        "category": {
          "type": "string",
          "enum": ["electricity", "water", "internet", "rent", "insurance", "other"]
        },
        "amount": {
          "type": "number",
          "description": "Amount due"
        },
        "dueDate": {
          "type": "string",
          "description": "ISO date string"
        },
        "status": {
          "type": "string",
          "enum": ["Paid", "Upcoming", "Due Soon", "Overdue"]
        },
        "recurring": {
          "type": "boolean"
        },
        "frequency": {
          "type": "string",
          "enum": ["monthly", "quarterly", "yearly"]
        },
        "reminder": {
          "type": "boolean"
        },
        "reminderDays": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": ["name", "category", "amount", "dueDate", "status", "recurring", "frequency", "reminder", "reminderDays", "notes", "userId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual profiles of the registered users."
    },
    "bills/{billId}": {
      "schema": "Bill",
      "description": "The collections of bills added by users."
    }
  }
}
